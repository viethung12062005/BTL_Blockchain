# URL RPC mạng Sepolia (Khuyên dùng từ Alchemy hoặc Infura để ổn định hơn)
SEPOLIA_RPC_URL="https://rpc.sepolia.org"

# Private Key của ví deploy (Lấy từ MetaMask -> Account Details -> Show Private Key)
# Đừng quên thêm 0x ở đầu nếu chưa có
PRIVATE_KEY="YOUR_PRIVATE_KEY_HERE"

# API Key Etherscan (Tùy chọn, để verify code)
ETHERSCAN_API_KEY=""